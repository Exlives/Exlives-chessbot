{
  "manifest_version": 3,
  "name": "Exlives chessbot",
  "version": "1.0.0",
  "description": "Exlives chessbot, Chess.com ve Lichess satranç tahtalarını analiz ederek hamle önerisi sunar.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["activeTab", "scripting", "windows", "system.display", "tabs"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "action": {
    "default_title": "Exlives chessbot — Tahtayı analiz et",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["https://*.chess.com/*", "https://*.lichess.org/*", "https://worldchess.com/*", "https://*.worldchess.com/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }]
}
